# Managed by Ansible (platform_app role) — do not edit by hand.
# Read by ditto-platform-pylon.service (root) as its systemd environment. These
# are exactly the values docker compose interpolated from update.sh's exported
# .env for the pylon service; the other pylon variables keep their compose
# defaults, as they did then.
SUBTENSOR_NETWORK={{ platform_subtensor_network }}
PYLON_OPEN_ACCESS_TOKEN={{ platform_secrets.pylon_token }}
BITTENSOR_WALLET_PATH=/home/{{ platform_owner }}/.bittensor/wallets
